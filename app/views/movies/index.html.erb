<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>Movies</h1>

<table>
  <thead>
    <tr>
      <th class="<%= 'sorted-asc' if @sort_column == 'title' && @sort_direction == 'asc' %><%= 'sorted-desc' if @sort_column == 'title' && @sort_direction == 'desc' %>">
        <%= link_to "Title#{' ▲' if @sort_column == 'title' && @sort_direction == 'asc'}#{' ▼' if @sort_column == 'title' && @sort_direction == 'desc'}",
            movies_path(sort: "title",
            direction: (@sort_column == "title" && @sort_direction == "asc") ? "desc" : "asc") %>
      </th>

      <th class="<%= 'sorted-asc' if @sort_column == 'rating' && @sort_direction == 'asc' %><%= 'sorted-desc' if @sort_column == 'rating' && @sort_direction == 'desc' %>">
        <%= link_to "Rating#{' ▲' if @sort_column == 'rating' && @sort_direction == 'asc'}#{' ▼' if @sort_column == 'rating' && @sort_direction == 'desc'}",
            movies_path(sort: "rating",
            direction: (@sort_column == "rating" && @sort_direction == "asc") ? "desc" : "asc") %>
      </th>

      <th class="<%= 'sorted-asc' if @sort_column == 'release_date' && @sort_direction == 'asc' %><%= 'sorted-desc' if @sort_column == 'release_date' && @sort_direction == 'desc' %>">
        <%= link_to "Release Date#{' ▲' if @sort_column == 'release_date' && @sort_direction == 'asc'}#{' ▼' if @sort_column == 'release_date' && @sort_direction == 'desc'}",
            movies_path(sort: "release_date",
            direction: (@sort_column == "release_date" && @sort_direction == "asc") ? "desc" : "asc") %>
      </th>

      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= movie.title %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%B %d, %Y") %></td>
        <td><%= link_to "Show", movie %></td>
      </tr>
    <% end %>
  </tbody>

  <tfoot>
    <tr>
      <td colspan="4">
        Total movies: <%= @movies.count %>
      </td>
    </tr>
  </tfoot>
</table>

<p>
  <%= link_to "New movie", new_movie_path %>
</p>
